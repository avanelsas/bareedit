{:paths ["src/server" "src/shared" "resources"]
 :tasks
 {:requires ([babashka.fs :as fs] [clojure.string :as str])
  start {:doc "Start the editor for the current folder"
         :task (apply (requiring-resolve 'bare-edit.main/-main) *command-line-args*)}
  test  {:doc "Run the server and shared tests under bb"
         :extra-paths ["test" "dev"]
         :requires ([clojure.test :as t])
         :task (let [nss '[bare-edit.protocol-test bare-edit.paths-test bare-edit.files-test bare-edit.server-test
                           bare-edit.docstrings-test bare-edit.repl-test bare-edit.nrepl-test
                           bare-edit.shadow-test bare-edit.config-test bare-edit.main-test]]
                 (apply require nss)
                 (let [{:keys [fail error]} (apply t/run-tests nss)]
                   (System/exit (if (zero? (+ fail error)) 0 1))))}
  cljs-test {:doc "Run the shared tests under ClojureScript (Node)"
             :task (do (shell "npx shadow-cljs compile test")
                       (shell "node out/test.js"))}
  build {:doc "Build the browser bundle into resources/public/js"
         :task (shell "npx shadow-cljs release app")}
  jar {:doc "Build the jar for Clojars into target. A version tag on HEAD gives the version, else 0.0.0-SNAPSHOT"
       :depends [build]
       :task (let [tag     (-> (shell {:out :string :err :string :continue true}
                                      "git describe --tags --exact-match --match v[0-9]*")
                               :out str/trim)
                   version (if (str/blank? tag) "0.0.0-SNAPSHOT" (subs tag 1))]
               (shell "clojure" "-T:build" "jar" ":version" (pr-str version)))}
  docstrings {:doc "Check every docstring against .claude/rules/docstrings.md; exits 1 on a problem"
              :extra-paths ["dev"]
              :task (apply (requiring-resolve 'bare-edit.docstrings/-main) *command-line-args*)}}}
