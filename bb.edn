{:paths ["src/server" "src/shared" "resources"]
 :tasks
 {:requires ([babashka.fs :as fs])
  start {:doc "Start the editor for the current folder"
         :task (apply (requiring-resolve 'bare-edit.main/-main) *command-line-args*)}
  test  {:doc "Run the server and shared tests under bb"
         :extra-paths ["test" "dev" "github-pages-demo/src" "github-pages-demo/test"]
         :requires ([clojure.test :as t])
         :task (let [nss '[bare-edit.protocol-test bare-edit.paths-test bare-edit.files-test bare-edit.server-test
                           bare-edit.docstrings-test bare-edit.repl-test bare-edit.nrepl-test
                           bare-edit.shadow-test bare-edit.config-test bare-edit.main-test bare-edit.search-test
                           bare-edit.github-pages-demo.snapshot-test]]
                 (apply require nss)
                 (let [{:keys [fail error]} (apply t/run-tests nss)]
                   (System/exit (if (zero? (+ fail error)) 0 1))))}
  cljs-test {:doc "Run the shared tests under ClojureScript (Node)"
             :task (do (shell "npx shadow-cljs compile test")
                       (shell "node out/test.js"))}
  build {:doc "Build the browser bundle into resources/public/js"
         :task (shell "npx shadow-cljs release app")}
  jar {:doc "Build the jar for Clojars into target, with the version of the tag on HEAD"
       :depends [build]
       :task (shell "clojure -T:build jar")}
  install {:doc "Build the jar and install it in the local Maven repository"
           :depends [build]
           :task (shell "clojure -T:build install")}
  github-pages-demo {:doc "Build the read-only demo for GitHub Pages into the folder of its build in shadow-cljs.edn"
                     :extra-paths ["github-pages-demo/src"]
                     :requires ([clojure.edn :as edn])
                     :task (let [js  (-> (slurp "shadow-cljs.edn") edn/read-string
                                         (get-in [:builds :github-pages-demo :output-dir]))
                                 out (str (fs/parent js))]
                             (shell "npx shadow-cljs release github-pages-demo")
                             (fs/copy "resources/public/index.html" (str out "/index.html")
                                      {:replace-existing true})
                             ((requiring-resolve 'bare-edit.github-pages-demo.snapshot/write!)
                              "." (str out "/github-pages-demo.edn")))}
  docstrings {:doc "Check every docstring against .claude/rules/docstrings.md; exits 1 on a problem"
              :extra-paths ["dev"]
              :task (apply (requiring-resolve 'bare-edit.docstrings/-main) *command-line-args*)}}}
